{
  "name": "pontual-docente-rn",
  "version": "1.0.0",
  "description": "Aplicativo React Native (Expo) para controle de grade horária docente (IESB 2027/1 e múltiplos semestres) e ponto eletrônico inteligente com banco SQLite/JSON local.",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
